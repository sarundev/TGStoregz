# Copy this file to .env and put your real values in .env — NOT in this file.
BOT_TOKEN=123456789:your-bot-token-here

# Your Telegram user ID (send /myid to the bot). Comma-separate multiple admins.
ADMIN_IDS=123456789

# Group that receives orders (add the bot to the group, send /groupid there to get this number).
# Everyone in the group can press the order buttons. Leave empty to send orders to ADMIN_IDS privately.
ORDER_GROUP_ID=

BOT_TITLE=TG ExpertG
CONTACT_TEXT=Telegram: @sarun_chann

# ---- Payment ----
# manual  = your own ABA QR image; customer sends a receipt screenshot; admin approves
# rielpay = RielPay (rielpays.com); dynamic KHQR + automatic payment confirmation
# payway  = ABA PayWay API directly (needs a PayWay merchant API account)
PAYMENT_MODE=manual

# rielpay mode: secret key from rielpays.com → Stores → API keys
# New stores start in TEST mode (no real money). Go live in the RielPay dashboard.
RIELPAY_API_KEY=

# manual mode: your ABA KHQR image (save it from ABA Mobile) placed in this folder
ABA_QR_IMAGE=aba_qr.jpg

# rielpay + payway: public address of this bot (e.g. your Railway domain).
# When set, the "📱 បើក ABA Mobile" button opens the ABA app directly.
# Leave empty to use RielPay's checkout page instead.
PUBLIC_URL=

# Railway: folder on the Volume where orders.json is saved (e.g. /data). Leave empty on your Mac.
DATA_DIR=
